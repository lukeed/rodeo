{{#var home = $page.path === "/"}}
{{#var docs = !!$page.params.group}}
{{#var lost = $page.path === "/404.html"}}
{{#var title = home ? "rodeo: round up your terminals" : $page.title + " · rodeo"}}
{{#var summary = $utils.plain($page.summary || $site.description)}}
{{#var alt = "rodeo: round up your terminals."}}
<!doctype html>
<html lang="{{ $site.lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ summary }}" />
    {{#if lost}}
      <meta name="robots" content="noindex" />
    {{#else}}
      <link rel="canonical" href="{{ $page.url }}" />
    {{/if}}
    {{#if docs}}
      <bongo:alternate type="text/markdown" />
    {{/if}}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rodeo" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ summary }}" />
    <meta property="og:url" content="{{ $page.url }}" />
    <meta property="og:image" content="{{ new URL($site.url).origin }}<bongo:asset src='img/og.png' />" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ alt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="{{ alt }}" />
    <meta name="theme-color" content="#0F0E0D" />
    <link rel="icon" type="image/svg+xml" href="<bongo:asset src='img/favicon.svg' />" />
    <link rel="apple-touch-icon" href="<bongo:asset src='img/touch.png' />" />
    <bongo:asset preload src="fonts/geist-mono.woff2" />
    <bongo:style src="style.css"></bongo:style>
    {{#if $utils.production()}}
      <script defer src="/x/script.js" data-endpoint="/x"></script>
    {{/if}}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {{#if home}}
      <div class="hband" aria-hidden="true"><canvas data-world="corral" data-panel=".tui" data-avoid=".top, .hero > div"></canvas></div>
    {{#else}}
      <div class="hband short" aria-hidden="true"><canvas data-world="night" data-avoid=".top"></canvas></div>
    {{/if}}
    {{#partial src="top" docs=docs}}
    {{{ $page.content }}}
    <div class="hfoot" aria-hidden="true"><canvas data-world="horizon"></canvas></div>
    {{#partial src="footer"}}
    <bongo:script src="main.ts"></bongo:script>
  </body>
</html>
