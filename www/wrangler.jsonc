{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rodeo-www",
  "compatibility_date": "2026-11-10",
  "main": "./worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs on the crowne.io paths, the install script, the release downloads, and `/`, which serves either one by user agent.
    "run_worker_first": ["/x/script.js", "/x", "/install.sh", "/download/*", "/"],
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "rodeo-releases" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "vars": {
    // The crowne.io site id. The key is a secret: wrangler secret put CROWNE_KEY
    "CROWNE_SITE": "01M71ZG3J8RVJE8C8TPP7QFT6X",
  },
  "routes": [{ "pattern": "rodeo.lukeed.com", "custom_domain": true }],
}
